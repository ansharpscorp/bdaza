def upsert_manifest_batch(rows: List[Dict[str, Any]]) -> None:
    if not rows:
        return

    df = spark.createDataFrame(rows, schema=MANIFEST_SCHEMA)
    temp_view = f"tmp_manifest_upsert_{uuid.uuid4().hex}"
    df.createOrReplaceTempView(temp_view)

    spark.sql(f"""
    MERGE INTO {MANIFEST_TABLE} tgt
    USING {temp_view} src
      ON tgt.call_id = src.call_id
    WHEN MATCHED THEN UPDATE SET
      tgt.record_start_utc = src.record_start_utc,
      tgt.record_end_utc = src.record_end_utc,
      tgt.interval_start_utc = src.interval_start_utc,
      tgt.interval_end_utc = src.interval_end_utc,
      tgt.json_path = src.json_path,
      tgt.parquet_path = src.parquet_path,
      tgt.json_status = src.json_status,
      tgt.parquet_status = src.parquet_status,
      tgt.json_retry_count = src.json_retry_count,
      tgt.parquet_retry_count = src.parquet_retry_count,
      tgt.last_error = src.last_error,
      tgt.last_updated_utc = src.last_updated_utc
    WHEN NOT MATCHED THEN INSERT *
    """)
    spark.catalog.dropTempView(temp_view)

def write_interval_checkpoint(
    interval_start: datetime,
    interval_end: datetime,
    listed_count: int,
    json_success_count: int,
    json_failed_count: int,
    status: str,
    last_error: Optional[str]
) -> None:
    rows = [{
        "interval_start_utc": interval_start.replace(tzinfo=None),
        "interval_end_utc": interval_end.replace(tzinfo=None),
        "listed_count": int(listed_count),
        "json_success_count": int(json_success_count),
        "json_failed_count": int(json_failed_count),
        "status": status,
        "last_updated_utc": utc_now().replace(tzinfo=None),
        "last_error": last_error[:4000] if last_error else None
    }]
    df = spark.createDataFrame(rows, schema=INTERVAL_CHECKPOINT_SCHEMA)
    df.write.format("delta").mode("append").saveAsTable(CHECKPOINT_TABLE)

def get_already_successful_json_ids(call_ids: List[str]) -> set:
    if not call_ids:
        return set()

    df = (
        spark.table(MANIFEST_TABLE)
        .filter(F.col("call_id").isin(call_ids))
        .filter(F.col("json_status") == "SUCCESS")
        .select("call_id")
        .distinct()
    )
    return {r["call_id"] for r in df.collect()}


