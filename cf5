def run_interval(interval_start: datetime, interval_end: datetime) -> None:
    interval_begin_ts = time.time()
    reset_interval_throttle_counter()

    all_call_ids = sorted(set(list_call_ids_for_interval(interval_start, interval_end)))
    found_count = len(all_call_ids)

    already_done = get_already_successful_json_ids(all_call_ids)
    pending_call_ids = [cid for cid in all_call_ids if cid not in already_done]

    skipped_count = len(already_done)
    pending_count = len(pending_call_ids)

    success_count = 0
    fail_count = 0
    batch_results = []

    if pending_call_ids:
        workers = choose_worker_count(BASE_WORKERS)

        with ThreadPoolExecutor(max_workers=workers) as executor:
            future_map = {
                executor.submit(process_call_json, call_id, interval_start, interval_end): call_id
                for call_id in pending_call_ids
            }

            for future in as_completed(future_map):
                result = future.result()
                batch_results.append(result)

                if result["json_status"] == "SUCCESS":
                    success_count += 1
                else:
                    fail_count += 1

        upsert_manifest_batch(batch_results)

    write_interval_checkpoint(
        interval_start=interval_start,
        interval_end=interval_end,
        listed_count=found_count,
        json_success_count=success_count,
        json_failed_count=fail_count,
        status="PARTIAL_SUCCESS" if fail_count > 0 else "SUCCESS",
        last_error=None
    )

    elapsed = time.time() - interval_begin_ts

    log_info(
        f"Interval: {to_utc_str(interval_start)} -> {to_utc_str(interval_end)} | "
        f"Found: {found_count} | Pending: {pending_count} | Skipped: {skipped_count}"
    )
    log_info(
        f"Json: Success: {success_count} | Failed: {fail_count} | TimeTaken: {format_duration(elapsed)}"
    )
    log_info("=" * 100)


