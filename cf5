def process_call_json(call_id: str, interval_start: datetime, interval_end: datetime) -> Dict[str, Any]:
    last_error = None

    for attempt in range(RETRY_LIMIT + 1):
        try:
            payload = build_combined_json(call_id)

            record_start = payload.get("startDateTime")
            record_end = payload.get("endDateTime")

            if not record_start:
                raise ValueError(f"Missing startDateTime for call_id={call_id}")

            json_path = get_json_target_path(call_id, record_start)
            ensure_dir(json_path.rsplit("/", 1)[0])

            if OVERWRITE_EXISTING:
                safe_rm(json_path)
            elif path_exists(json_path):
                return {
                    "call_id": str(call_id),
                    "record_start_utc": datetime.fromisoformat(record_start.replace("Z", "+00:00")).replace(tzinfo=None) if record_start else None,
                    "record_end_utc": datetime.fromisoformat(record_end.replace("Z", "+00:00")).replace(tzinfo=None) if record_end else None,
                    "interval_start_utc": interval_start.replace(tzinfo=None),
                    "interval_end_utc": interval_end.replace(tzinfo=None),
                    "json_path": json_path,
                    "parquet_path": None,
                    "json_status": "SUCCESS",
                    "parquet_status": "PENDING",
                    "json_retry_count": int(attempt),
                    "parquet_retry_count": 0,
                    "last_error": "SKIPPED_ALREADY_EXISTS",
                    "last_updated_utc": utc_now().replace(tzinfo=None)
                }

            write_text(json_path, json.dumps(payload, ensure_ascii=False, indent=2))

            return {
                "call_id": str(call_id),
                "record_start_utc": datetime.fromisoformat(record_start.replace("Z", "+00:00")).replace(tzinfo=None) if record_start else None,
                "record_end_utc": datetime.fromisoformat(record_end.replace("Z", "+00:00")).replace(tzinfo=None) if record_end else None,
                "interval_start_utc": interval_start.replace(tzinfo=None),
                "interval_end_utc": interval_end.replace(tzinfo=None),
                "json_path": json_path,
                "parquet_path": None,
                "json_status": "SUCCESS",
                "parquet_status": "PENDING",
                "json_retry_count": int(attempt),
                "parquet_retry_count": 0,
                "last_error": None,
                "last_updated_utc": utc_now().replace(tzinfo=None)
            }

        except Exception as e:
            last_error = f"{type(e).__name__}: {str(e)}"
            if attempt < RETRY_LIMIT:
                sleep_with_jitter(min(60, 2 ** attempt))

    return {
        "call_id": str(call_id),
        "record_start_utc": None,
        "record_end_utc": None,
        "interval_start_utc": interval_start.replace(tzinfo=None),
        "interval_end_utc": interval_end.replace(tzinfo=None),
        "json_path": None,
        "parquet_path": None,
        "json_status": "FAILED",
        "parquet_status": "PENDING",
        "json_retry_count": int(RETRY_LIMIT + 1),
        "parquet_retry_count": 0,
        "last_error": last_error,
        "last_updated_utc": utc_now().replace(tzinfo=None)
    }


