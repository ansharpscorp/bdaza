def log_info(msg: str) -> None:
    print(msg)

def log_debug(msg: str) -> None:
    if VERBOSE_LOGS:
        print(msg)

def utc_now() -> datetime:
    return datetime.now(timezone.utc)

def floor_to_hour(dt: datetime) -> datetime:
    return dt.replace(minute=0, second=0, microsecond=0)

def to_utc_str(dt: datetime) -> str:
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

def parse_date_utc(date_str: str, hour: int = 0) -> datetime:
    return datetime.strptime(f"{date_str} {hour:02d}:00:00", "%Y-%m-%d %H:%M:%S").replace(tzinfo=timezone.utc)

def date_parts_from_dt(dt: datetime) -> Tuple[str, str, str]:
    return dt.strftime("%Y"), dt.strftime("%m"), dt.strftime("%d")

def sleep_with_jitter(seconds: float) -> None:
    time.sleep(seconds + random.uniform(0, 1.0))

def ensure_dir(path: str) -> None:
    try:
        dbutils.fs.mkdirs(path)
    except Exception:
        pass

def safe_rm(path: str) -> None:
    try:
        dbutils.fs.rm(path, True)
    except Exception:
        pass

def path_exists(path: str) -> bool:
    try:
        parent = path.rsplit("/", 1)[0]
        name = path.rsplit("/", 1)[1]
        for f in dbutils.fs.ls(parent):
            if f.name.rstrip("/") == name.rstrip("/"):
                return True
        return False
    except Exception:
        return False

def format_duration(seconds: float) -> str:
    seconds = int(seconds)
    h = seconds // 3600
    m = (seconds % 3600) // 60
    s = seconds % 60
    return f"{h:02d}:{m:02d}:{s:02d}"

def write_text_hadoop(path: str, content: str, overwrite: bool = True) -> None:
    """
    Write UTF-8 text using Hadoop FS API.
    Avoids dbutils.fs.put notebook output.
    """
    jvm = spark._jvm
    hadoop_conf = spark._jsc.hadoopConfiguration()
    fs = jvm.org.apache.hadoop.fs.FileSystem.get(hadoop_conf)
    jpath = jvm.org.apache.hadoop.fs.Path(path)

    stream = None
    writer = None
    try:
        stream = fs.create(jpath, overwrite)
        writer = jvm.java.io.OutputStreamWriter(stream, "UTF-8")
        writer.write(content)
        writer.flush()
    finally:
        if writer is not None:
            writer.close()
        elif stream is not None:
            stream.close()

def write_text(path: str, content: str) -> None:
    write_text_hadoop(path, content, overwrite=True)

def get_json_target_path(call_id: str, start_dt_str: str) -> str:
    start_dt = datetime.fromisoformat(start_dt_str.replace("Z", "+00:00"))
    yyyy, mm, dd = date_parts_from_dt(start_dt)
    return f"{JSON_ABFSS_BASE}/{yyyy}/{mm}/{dd}/{call_id}.json"


