def choose_worker_count(default_workers: int = BASE_WORKERS) -> int:
    with throttle_lock:
        recent_429 = throttle_state["recent_429"]

    if recent_429 >= 20:
        return max(MIN_WORKERS, 2)
    elif recent_429 >= 10:
        return max(MIN_WORKERS, 4)
    elif recent_429 >= 5:
        return min(default_workers, 6)
    else:
        return min(default_workers, MAX_WORKERS)

def reset_interval_throttle_counter() -> None:
    with throttle_lock:
        throttle_state["recent_429"] = 0


